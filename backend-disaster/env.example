# API Keys for Production
OPENWEATHER_API_KEY=your_openweather_api_key_here
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
SENTINEL_HUB_CLIENT_ID=your_sentinel_hub_client_id_here
SENTINEL_HUB_CLIENT_SECRET=your_sentinel_hub_client_secret_here
USGS_API_KEY=your_usgs_api_key_here

# Optional: Gemini writes the disaster-prediction advisory (rule-based fallback if unset)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: event peak days that raise the crowd/stampede forecast (YYYY-MM-DD, comma-separated)
EVENT_PEAK_DATES=

# Flask Configuration
SECRET_KEY=your_flask_secret
FLASK_ENV=production
FLASK_DEBUG=False

# Render Configuration
PORT=10000
HOST=0.0.0.0
